# Example environment variables for ai_server.py
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=400
PORT=3000

# Optional: Custom OpenAI-compatible base URL (e.g. NVIDIA NIM, Ollama, vLLM)
# AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# CORS: Comma-separated allowed frontend origins (default: http://localhost:8000)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: Firebase Admin service account JSON (escaped single-line string)
# FIREBASE_ADMIN_SDK_JSON={"type":"service_account","project_id":"echoserve",...}
